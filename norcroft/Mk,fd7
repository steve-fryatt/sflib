| Obtain the date and version information from the parent folder.

Dir <Obey$Dir>.^

BuildInfo -quiet -versionvar SFLib$BuildVersion

| Compile the library.

Dir <Obey$Dir>

WimpSlot -min 8192k
amu all_libs THROWBACK=-throwback

| Copy the files around and package them up.

CDir sflib
Copy h sflib.h ~CFRV
zip -9 -r "^.^.sflib<SFLib$BuildVersion>/zip" "Licence" "o.SFLib" "ReadMe" "SetVars" "sflib.h" -x "sflib.h.strdup"

| Tidy up.

Unset SFLib$BuildVersion